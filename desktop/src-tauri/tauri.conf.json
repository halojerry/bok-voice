{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BokVoice",
  "version": "0.1.0",
  "identifier": "com.bokvoice.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bok Voice",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Bok Voice 客服语音助手",
    "longDescription": "本地优先、可审计的实时客服语音助手与同声传译工作台。",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 440
        }
      }
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": [],
    "externalBin": [],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
