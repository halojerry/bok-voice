{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BokVoice",
  "version": "0.1.0",
  "identifier": "com.bokvoice.desktop",
    "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../../apps/web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bok Voice 客服助手",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Bok Voice 客服语音助手",
    "longDescription": "本地优先、可审计的实时语音客服与同声传译工作台。",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 440
        }
      }
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": [
      "../../apps/agent",
      "../../apps/control-plane",
      "../../packages/core",
      "../../packages/business-db",
      "../../packages/knowledge",
      "../../packages/observability",
      "../../services/qwen3-asr-sidecar",
      "../../services/qwen3-tts-sidecar",
      "../../services/llm-mlx",
      "../../services/realtime-translation",
      "../runtime",
      "../../tools/bok.py",
      "../../scripts/start_sidecars.sh",
      "../../scripts/stop_sidecars.sh"
    ],
    "externalBin": [],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
