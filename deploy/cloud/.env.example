# Bok Voice 云端控制面环境变量模板。
# 用法：cp .env.example .env → 逐项填好 → docker compose up -d（详见 README.md）。
# .env 含密钥，绝不提交仓库/外传；改完执行 `docker compose up -d` 重建容器生效。

# ── 业务库（必填）────────────────────────────────────────────────────────────
# Supabase Postgres。**必须用 Supavisor session pooler 的 IPv4 5432 端**：
#   Dashboard → Project Settings → Database → Connection string → Session pooler，
#   格式：postgresql+psycopg://postgres.[项目ref]:[密码]@aws-0-[区域].pooler.supabase.com:5432/postgres
#   （ref=项目 ID，如 abcdefghijklmnop；驱动前缀必须是 postgresql+psycopg，
#   写 postgresql:// 会被 SQLAlchemy 解析成 psycopg2 而镜像里装的是 psycopg3。）
# 两个禁区：
#   ✗ 端口 6543（transaction mode pooler）——SQLAlchemy 的 prepared statements 与
#     事务模式池冲突，会随机报 prepared statement "..." does not exist；
#   ✗ 直连 db.*.supabase.com:5432——纯 IPv6 解析，国内 VPS 多半没有 IPv6 出口，
#     连接直接失败。
#DATABASE_URL=postgresql+psycopg://postgres.abcdefghijklmnop:你的数据库密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── 认证（云端固定开）───────────────────────────────────────────────────────
# 1=开启用户 JWT 门禁（三层 RBAC：root/admin/user）。云端必须为 1——置 0 等于
# 全部 API 裸奔公网。CP startup 对「开了认证却没有 JWT 密钥」fail-closed 拒启。
BOK_AUTH_REQUIRED=1

# 用户 JWT 签发/校验密钥（必填）。生成：openssl rand -hex 32
# 铁律：**泄露=全部 token 可伪造**（攻击者可自签 root JWT 冒充任意管理员），
# 一旦怀疑泄露立即换新值并重启（所有已签发 token 立即失效，用户需重新登录）。
BOK_JWT_SECRET=请替换为openssl_rand_hex_32的输出

# 机器通道钥匙（BOK_CP_TOKEN）。脚本/CI/**agent worker** 直调 CP 的钥匙：
# 分布式部署时，客户节点 agent worker 的 env 必须带同值，否则转写落库、
# WhatsApp 上报、设置读取等机器调用会被门禁拦成 401。
# 生成：openssl rand -hex 24
BOK_CP_TOKEN=请替换为openssl_rand_hex_24的输出

# ── 首次启动 root 种子 ───────────────────────────────────────────────────────
# CP 启动时幂等种子 root 账号（同名用户已存在=跳过，**改这两个值不会重置
# 已有账号的密码**）。用这个账号登录管理台后，先到「员工管理」建日常用的
# 主管账号，root 只留应急。
BOK_ROOT_USERNAME=admin
BOK_ROOT_PASSWORD=请替换为强密码

# ── 端口与镜像（一般不用改）─────────────────────────────────────────────────
# 宿主端口：8000 被占/要走宝塔反代时改（容器内恒为 8000）。
BOK_CP_PORT=8000

# 镜像 tag：默认 CI 发布的 latest。留空=用 compose 里的默认值；
# 排练/回滚时可钉版本，如 ghcr.io/halojerry/bok-voice:sha-abb163b。
#BOK_CP_IMAGE=ghcr.io/halojerry/bok-voice:latest
