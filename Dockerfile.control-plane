ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY packages/core /app/packages/core
COPY packages/business-db /app/packages/business-db
COPY packages/knowledge /app/packages/knowledge
COPY packages/observability /app/packages/observability
COPY apps/control-plane /app/apps/control-plane

RUN pip install --no-cache-dir \
    -e /app/packages/core \
    -e /app/packages/business-db \
    -e /app/packages/knowledge \
    -e /app/packages/observability \
    -e /app/apps/control-plane

RUN mkdir -p /app/data/vault

EXPOSE 8000
CMD ["uvicorn", "control_plane.main:app", "--host", "0.0.0.0", "--port", "8000"]
