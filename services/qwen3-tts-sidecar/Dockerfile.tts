FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.110,<1" \
    "uvicorn[standard]>=0.29,<1" \
    "python-multipart>=0.0.9" \
    "numpy>=1.26,<3" \
    "soundfile>=0.12" \
    "librosa>=0.10" \
    "httpx>=0.27,<1" \
    "qwen-tts>=0.1.1"

COPY app.py /app/app.py

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8788"]
