# LiveKit（本地内嵌二进制，绑 127.0.0.1）
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Control Plane（分发默认 SQLite + app-data vault；Postgres 仅云/未来）
# DATABASE_URL=postgresql+psycopg://bok:bok@localhost:5432/bok_voice
# VAULT_ROOT=./data/vault

# Web（服务只绑 127.0.0.1；避免 localhost 优先解析 ::1 导致 fetch 失败）
NEXT_PUBLIC_CONTROL_PLANE_URL=http://127.0.0.1:8000
# B 线同声传译 worker（services/realtime-translation/server.mjs，默认 8790）
NEXT_PUBLIC_TRANSLATION_WS_URL=ws://127.0.0.1:8790

# Local Qwen3 sidecars
QWEN3_ASR_BASE_URL=http://127.0.0.1:8787
QWEN3_TTS_BASE_URL=http://127.0.0.1:8788

# Local LLM（mlx_lm / llama-server，OpenAI 兼容）
MLX_LLM_BASE_URL=http://127.0.0.1:1235/v1
