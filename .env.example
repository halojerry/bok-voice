# Local Qwen3 sidecars
QWEN3_ASR_BASE_URL=http://127.0.0.1:8787
QWEN3_TTS_BASE_URL=http://127.0.0.1:8788

# Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:9b
