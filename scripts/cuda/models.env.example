# ---- scripts/cuda/models.env.example：模型清单（bootstrap.sh 消费） ----
# 用法：cp scripts/cuda/models.env.example scripts/cuda/models.env 后逐键定稿。
# ⚠ 全部 repo id 是占位 TODO——开窗时按当时选型定稿再填，勿臆造仓库名。

# ---------- sglang 吃什么格式（先读这段再选仓库） ----------
# sglang 只吃 **HF safetensors 格式**仓库。仓内现有模型表（tools/bok.py MODELS）
# 的 mac 档是 MLX 4bit、windows 档是 llama.cpp GGUF——**都不能给 sglang 用**，
# 不要照抄那两张表的 repo id。量化（fp8/awq/gptq）在 sglang 侧由
# --quantization 旗标声明（或直接下预量化仓库），与权重格式互为表里。

# ---------- a_reply 车道（大杯候选，:18100） ----------
# 用途：A 线回复轮自由 LLM（KV 前缀契约的承载者；跳过 LLM 的直念/快路轮不打这里）。
# 选型方向：9B 级 Qwen3.5 系、无思考档优先（对照 Mac 4B 的质量差值判据，阶段 D）。
# MODEL_A_REPLY_REPO=TODO-org/TODO-qwen3.5-9b-instruct-safetensors
# 落盘目录名（bootstrap 下载目标；env.example 的 MODEL_A_REPLY_DIR 指向 <MODELS>/a_reply）。
MODEL_A_REPLY_DIRNAME=a_reply
# 显存账（估算，开窗时以 sglang 启动日志实际分配为准）：
#   bf16 权重 ~18G；fp8 ~9-10G；KV cache 走 --mem-fraction-static 预算池。

# ---------- judge/settle 车道（判据档，:18101） ----------
# 用途：flow judge / 意图批量判定 / settle 纪要 / L-① 挖掘（延迟不敏感岗位）。
# Mac 现役 = Huihui-Qwen3.5-9B 的 MLX 4bit——CUDA 档要找同一模型的 HF safetensors
# 版（若无官方版，开窗时在 Huihui-ai 组织下确认；找不到再退同尺寸替代并记 A/B 结论）。
# MODEL_JUDGE_REPO=TODO-org/TODO-huihui-9b-safetensors
MODEL_JUDGE_DIRNAME=judge

# ---------- MT 车道（可选，B 线） ----------
# 阶段 D 含「MT-9B + 润色」议程；定稿后取消注释（bootstrap 会一并下载）。
# MODEL_MT_REPO=TODO-org/TODO-mt-9b
# MODEL_MT_DIRNAME=mt

# ---------- 显存预算表（单卡双实例 9B×2 口径；⚠估算值，实机以日志为准） ----------
#  sglang 预算 = --mem-fraction-static × 卡总显存（权重 + KV cache 共池）。
#  24G 卡（4090/3090）：装不下 9B×2 bf16——单实例 fp8 9B 或降小杯起步。
#  48G 卡（A6000/RTX 6000 Ada/L40S）：9B×2 bf16 勉强（36G 权重 + 激活，KV 池极薄），
#    建议 9B×2 fp8（~20G 权重，余 ~20G KV）。
#  80G 卡（A100/H100）：9B×2 bf16 宽裕（36G 权重 + ~32G KV，多路并发友好）。
#  KV 单价参考（Qwen3 系 9B 级 GQA，36 层 × 8 KV 头，bf16）：≈0.3MB/token，
#    即 32k 上下文 ≈ 10G/并发路——多路并发时 KV 池是第一瓶颈。
#  TTS SFT（阶段 C 并窗）另需 ~7G/epoch 磁盘（见 docs/TTS-SFT-PLAYBOOK.md §3），
#    与推理显存互不相干，但计入磁盘 ≥200G 预检余量。

# ---------- 下载守则 ----------
# 1) 网络一律走 HF_ENDPOINT 镜像（env.example 缺省 hf-mirror；国内机直连 HF 卡死）。
# 2) 磁盘：9B bf16 单模型 ~18-20G，两模型 ~40G；加缓存余量后仍须留足 200G 预检线。
# 3) bootstrap.sh 对 TODO/空 repo 直接跳过并告警，不会拿假仓库炸全流程；
#    但模型缺位时对应 sglang 单元起不来（smoke.sh 会点名 FAIL）。
