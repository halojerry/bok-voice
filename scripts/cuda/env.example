# ---- /etc/bok-cuda/bok-cuda.env 示例（Bok CUDA 部署运行时 env 面）----
# 用法（见 docs/CUDA-DEPLOY.md）：
#   install -d -m 700 /etc/bok-cuda
#   cp scripts/cuda/env.example /etc/bok-cuda/bok-cuda.env
#   $EDITOR /etc/bok-cuda/bok-cuda.env   # 逐键填值
#   chmod 600 /etc/bok-cuda/bok-cuda.env
# 语法：systemd EnvironmentFile 格式，一行 KEY=value，# 注释；**值不得含空格**
# （单元 ExecStart 里 $VAR 展开按词分列，含空格会把参数劈碎）。
# 三份 systemd 单元（sglang-a / sglang-judge / bok-node）共用本文件。

# ================= 1. 节点注册（bok-node.service） =================
# 云 CP 基址（必填）：节点心跳/注册目标。
BOK_CP_URL=https://cp.example.com
# 节点凭据：license 流（推荐）或预签发 token，二选一。
# license 流：同机幂等重注册复用 node_id，token 落 ~/.bok/node-state.json（0600）。
BOK_LICENSE_KEY=
# BOK_NODE_TOKEN=
# 节点名（云台显示用，缺省 CP 侧默认）。
BOK_NODE_NAME=cuda-gpu-1
# 指纹：机器指纹由 node_agent 自动采集（Linux = sha256(/etc/machine-id)），无需手填。
# 加固模式（auth-on 云 CP）需要 root 先在云台 nodes 页按指纹预绑定，预取命令：
#   sha256sum /etc/machine-id
# 详情见 AGENTS.md「三层 RBAC」与 docs/RUNTIME_TOPOLOGY.md「Ubuntu 节点形态」。

# 节点形态开关：
#   0（默认）= --heartbeat-only：只注册+心跳+commands 通道，不拉全栈——
#             本机的 LLM 服务由 sglang 单元独立承载，不与 bok 栈的 LLM 拉起逻辑混跑。
#   1        = 全栈节点：node_agent 经 cmd_up 拉起 CP/LiveKit/ASR/TTS/worker 全家
#             （照 tools/bok.py Ubuntu 节点姿势）。⚠未实测——首窗推荐 heartbeat-only，
#             全栈形态单独立项验证。
BOK_NODE_FULL_STACK=0
# 全栈模式才需要：仓库根（node_agent 按 <root>/tools/node_agent.py 定位自身）。
BOK_REPO_ROOT=/opt/bok-voice
# 全栈模式才需要：机器通道凭据（agent worker 调 CP 的 turns/设置上报过闸），
# 与云 CP 的 BOK_CP_TOKEN 同值。⚠ 机器通道凭据不落本文件以外的任何明文面。
# BOK_CP_TOKEN=
# 全栈模式才需要：媒体寻址（内网话务员可达）。
# BOK_LIVEKIT_BIND=192.168.1.10
# BOK_LIVEKIT_WEBHOOK_URL=https://cp.example.com/api/webhook/livekit

# ================= 2. sglang 服务（sglang-a / sglang-judge.service） =================
# 监听地址：0.0.0.0=供云 CP 路由跨机调用（默认）；仅本机 worker 消费时改 127.0.0.1。
SGLANG_BIND=0.0.0.0
# 端口：与本地区分（Mac 栈车道是 1235/1237），A 车道 18100、judge/settle 车道 18101。
SGLANG_PORT_A=18100
SGLANG_PORT_JUDGE=18101
# 排队策略（单元 --schedule-policy 的取值；缺省 fcfs）：
#   fcfs = 排队按「请求 priority 再先到先到」——priority 排队真生效，G5 主姿势；
#   lpm  = 排队按最长前缀匹配（radix 经济最大化），priority 只管抢占与缩退
#          （源码核实的取舍，战役并发档再切；两实例可各自独立取值）。
# 改后 systemctl restart 对应单元生效。
SGLANG_SCHEDULE_POLICY=fcfs
SGLANG_SCHEDULE_POLICY_JUDGE=fcfs
# API key：暴露到不可信网络时强烈建议启用——把单元文件里 --api-key 行的注释去掉，
# 并在此填值（零密钥字面量铁律：值只出现在本 env 文件，权限 600）。
# 消费方持 key 的姿势：云 CP 路由卡（model_routing_json 各车道 api_key 字段）下发；
# env 缺省链只认 FLOW_JUDGE_LLM_API_KEY 一个键，a_reply 车道走 env 链时塞不了 key，
# 所以「sglang 带 key 部署」配「路由表接入」一起用。
SGLANG_API_KEY=
# 模型目录与对外名：bootstrap.sh 按 models.env 下载后回填到下面的 *_DIR；
# 换模型 = 改这里 + systemctl restart，单元文件不动。
MODEL_A_REPLY_DIR=__MODELS_DIR__/a_reply
MODEL_A_REPLY_NAME=a-reply
MODEL_JUDGE_DIR=__MODELS_DIR__/judge
MODEL_JUDGE_NAME=judge-9b

# ================= 3. 车道指向（worker 消费面，二选一接线） =================
# 接线方式 A（本机全栈，BOK_NODE_FULL_STACK=1 时）：worker 与 sglang 同机，
#   取消下面注释即可——resolve_route 的 env 缺省链直读这些键。
#   （a_reply 车道主键 = MLX_LLM_BASE_URL；judge 主键 = FLOW_JUDGE_LLM_BASE_URL；
#    settle 主键 = BOK_SETTLE_LLM_BASE_URL；名字与端口是历史遗留，不必较真。）
# MLX_LLM_BASE_URL=http://127.0.0.1:18100/v1
# MLX_LLM_MODEL=a-reply
# FLOW_JUDGE_LLM_BASE_URL=http://127.0.0.1:18101/v1
# FLOW_JUDGE_LLM_MODEL=judge-9b
# BOK_SETTLE_LLM_BASE_URL=http://127.0.0.1:18101/v1
# MT_LLM_BASE_URL=http://127.0.0.1:18101/v1
#
# 接线方式 B（默认；worker 在 Mac/别处）：root 在云 CP 设置页路由卡把 a_reply/judge
# 车道切到 http://<本机内网IP>:18100/v1 与 :18101/v1（model_routing_json，
# model 字段填上面对应的 *_NAME）。热切换下一通生效，本文件**不要**动。
# ⚠ BOK_MODEL_ROUTING 是路由表的 kill-switch（=0 全表失效退 env 链），
#   不是路由配置本体——配置在云 CP，不在 env。此处保持不设（路由生效）。

# ================= 4. 下载与镜像（bootstrap.sh 消费） =================
# HF 镜像：国内机直连 huggingface.co 会卡死，缺省走 hf-mirror；海外机可覆盖回官方。
HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=            # 仅 gated 仓库需要；普通公开仓库留空
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple   # pip 镜像（可覆盖回官方）
