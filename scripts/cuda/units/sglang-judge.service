# Bok CUDA 部署包 —— sglang judge 车道（judge/settle/mining，:18101）
# 由 scripts/cuda/bootstrap.sh 渲染（替换 __BOK_CUDA_HOME__ 占位），操作员 root 装载。
# 运行时 env：/etc/bok-cuda/bok-cuda.env（与 sglang-a 共用一份；缺文件=拒绝启动）。
#
# 与 sglang-a（:18100）的分工：本实例服「延迟不敏感」岗位——flow judge / 意图批量
# 判定 / settle 纪要 / L-① 挖掘（对照 Mac 栈 :1237 的 Huihui-9B 常驻车道）。
# 旗标哲学与 sglang-a 相同（priority/lpm/radix 同一套，注释见 sglang-a.service 与
# docs/CUDA-DEPLOY.md §9），两点差异：
#   * --mem-fraction-static 略低（0.80）：两实例同卡时给 A 车道留显存余量，
#     OOM 第一道下调钮先动这里。
#   * SGLANG_SCHEDULE_POLICY 在 env 里两实例各自独立取值：judge 车道同话术/同判据
#     前缀高度重复，lpm 的排队经济性在这里更划算；要跟 A 车道同档就填同值。
# ⚠ 旗标随 sglang 版本漂移：实机首跑以 --help 为准核对。

[Unit]
Description=Bok sglang judge lane (judge/settle/mining) :18101 — priority scheduling + radix cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__BOK_CUDA_HOME__
EnvironmentFile=/etc/bok-cuda/bok-cuda.env
ExecStart=__BOK_CUDA_HOME__/venv/bin/python -m sglang.launch_server \
  --model-path $MODEL_JUDGE_DIR \
  --served-model-name $MODEL_JUDGE_NAME \
  --host $SGLANG_BIND \
  --port $SGLANG_PORT_JUDGE \
  --enable-priority-scheduling \
  --priority-scheduling-preemption-threshold 10 \
  --schedule-policy $SGLANG_SCHEDULE_POLICY_JUDGE \
  --retraction-policy priority \
  --mem-fraction-static 0.80 \
  --chunked-prefill-size 8192 \
  --log-level info
  # 可选（按需解开再 daemon-reload）：
  # --api-key $SGLANG_API_KEY
  # --quantization fp8
  # --device cuda:1                  # 双卡分实例时钉第二张
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
